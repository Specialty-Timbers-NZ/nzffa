- form_class = @subscription.active? ? 'edit_subscription' : 'new_subscription'
- form_method = (['modify', 'edit'].include? params[:action]) ? :put : :post
-form_for(@subscription, url: @action_path, html: {class: form_class, method: form_method}) do |f|
  =f.hidden_field :reader_id

  %h3 What is the size of your business?
  %div#business_size{style: "display: flex; flex-direction: row"}
    %div
      =f.radio_button :business_size, 'small'
      =f.label :business_size_small, 'small'
    %div
      =f.radio_button :business_size, 'medium'
      =f.label :business_size_medium, 'medium'
    %div
      =f.radio_button :business_size, 'large'
      =f.label :business_size_large, 'large'

  %h3 Farm Forestry Timbers Marketplace
  %p Farm Forestry Timbers is a society representing producers of specialty timbers. Joining means you can list your products or services and create adverts.
  %p#join_marketplace
    %label
      = f.check_box :belongs_to_fft, {class: 'sgt', checked: f.object.belongs_to_fft}, Group.fft_group.id
      Farm Forestry Timbers

  %h3 Consider other products?
  - Product.all.each do |product|
    %p
      = product.name
      = number_to_currency product.price
      %span{style: "float: right"}
        = text_field_tag "products_#{product.id}_amount", 0, {type: 'number', size: 2, name: "products[#{product.id}_amount]"}

  = render :partial => 'subscriptions/subscription_term_choices', :locals => {:f => f}
  = render :partial => 'subscriptions/expiry_date', :locals => {:f => f}
  = render :partial => 'subscriptions/amount_to_pay', :locals => {:f => f}

  - if params[:controller].match 'admin'
    = f.submit 'Proceed to payment'
  - else
    =f.submit 'Pay by credit card'
    or
    =f.submit 'Print and pay by direct credit'

= render :partial => 'subscriptions/quote_js'
