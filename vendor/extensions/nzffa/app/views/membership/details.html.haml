%table{:style => 'width: 100%'}
  %tr
    %td{:style => 'width: 50%; vertical-align: top'}
      %h2 Contact Details

      %p
        %b Membership ID:
        = @reader.nzffa_membership_id
        %br
        -cols = %w[email phone mobile fax organisation notes description post_line1 post_line2 region postcode post_organisation post_city post_province post_country]
        -cols.each do |col|
          %b="#{col.titleize}:"
          =@reader[col]
          %br
      %p=link_to 'Update your contact details', update_membership_path
    - if false
      %td{:style => 'vertical-align: top; width: 50%'}
        %h2 Subscription

        =render 'subscriptions/status'
